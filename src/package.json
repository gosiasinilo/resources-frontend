{
  "name": "my-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tailwindcss -i ./src/index.css -o ./dist/output.css --watch\"",
    "build": "tsc -b && vite build",
